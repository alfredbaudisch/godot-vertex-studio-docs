[
  {
    "label": "Build HTML",
    "command": "$ZED_WORKTREE_ROOT/venv/bin/python",
    "args": ["-m", "sphinx", "-M", "html", ".", "_build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Build & Preview HTML",
    "command": "$ZED_WORKTREE_ROOT/venv/bin/python",
    "args": ["preview.py"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never"
  }
]
